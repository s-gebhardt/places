# Copy to .env.places and adjust, then:
#   docker compose -p places --env-file deploy/compose/.env.places \
#     -f deploy/compose/docker-compose.places.yml up -d --build

# Upstream esgame frontend image the overlay builds FROM.
# Pin to :2.0.0 once that esgame release is tagged (1.9.0 predates the runtime-config + theming).
ESGAME_IMAGE=ghcr.io/mlacayoemery/esgame:master

# Public URL the browser posts game state to (the calculation backend).
# Local full stack: http://localhost:8000   Prod (example): https://esgame-calculation.containers.wurnet.nl/esgame
CALC_URL=http://localhost:8000

# GeoServer URL used by the calculation backend (server-to-server).
GEOSERVER_URL=http://localhost:8080/geoserver
