# All of these have working defaults for the local stack, so you only need this file to change
# something. Copy to .env.places and adjust, then:
#   docker compose -p places --env-file deploy/compose/.env.places \
#     -f deploy/compose/docker-compose.places.yml up -d --build

# Upstream esgame frontend image the overlay builds FROM.
# Pin to :2.0.0 once that esgame release is tagged (1.9.0 predates the runtime-config + theming).
ESGAME_IMAGE=ghcr.io/mlacayoemery/esgame:master

# Public URL the browser posts game state to (the calculation backend).
# Local full stack: http://localhost:8000   Prod (example): https://esgame-calculation.containers.wurnet.nl/esgame
CALC_URL=http://localhost:8000

# Where the geodata cache lives on the host. Populate it once with scripts/fetch-geodata.sh; the
# loader service copies it into the calculation's writable /app/data volume. Kept outside the repo
# because the rasters are not in git — see the README.
PLACES_GEODATA=/store/places/geodata

# GeoServer, server-to-server: the calculation publishes coverages over the REST API from inside
# the compose network, so this is the service name, not localhost.
GEOSERVER_URL=http://places-geoserver:8080/geoserver

# GeoServer, browser-facing: the WCS URLs the calculation returns are fetched by the client, which
# cannot resolve `places-geoserver`. Must be reachable from the browser — the published host port
# locally, the geoserver ingress in a real deployment.
GEOSERVER_PUBLIC_URL=http://localhost:8080/geoserver

# GeoServer admin credentials. Used to start the server AND by the calculation's REST client, so
# one pair covers both. Change them for anything reachable beyond your own machine: this account
# can publish and delete data.
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
